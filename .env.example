# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Centralized Gmail OAuth 2.0 Configuration (Developer / Application Owner)
# Configured ONCE by the maYa application owner in the server environment.
# Individual maYa users NEVER enter these values; each user authorizes their
# own Google account independently via Google's OAuth consent screen.
# Never commit real secrets or expose them to the browser.
#
# Google Cloud Console setup (once per deployment):
# 1. Enable the Gmail API in APIs & Services -> Library.
# 2. Configure the OAuth Consent Screen and add the read-only scope:
#    https://www.googleapis.com/auth/gmail.readonly
# 3. Create one OAuth 2.0 Client ID (Web application) and register Authorized
#    Redirect URIs matching GOOGLE_REDIRECT_URI:
#    <APP_URL>/api/integrations/gmail/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="MY_APP_URL/api/integrations/gmail/callback"

# 32-byte server-side encryption key (64 hex chars or 32-byte base64) used by
# AES-256-GCM to encrypt each user's OAuth access & refresh tokens at rest.
TOKEN_ENCRYPTION_KEY="MY_32_BYTE_TOKEN_ENCRYPTION_KEY"
